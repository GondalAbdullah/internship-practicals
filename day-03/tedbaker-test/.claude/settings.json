{
  "outputStyle": "Explanatory",
  "permissions": {
    "allow": [
      "WebFetch(domain:www.tedbaker.com)",
      "WebFetch(domain:getbootstrap.com)",
      "WebFetch(domain:icons.getbootstrap.com)"
    ],
    "ask": [
      "Bash(git commit *)"
    ],
    "deny": [
      "Bash(git push *)",
      "Bash(git reset *)",
      "Bash(git checkout *)",
      "Bash(git switch *)",
      "Bash(git rebase *)",
      "Bash(git merge *)",
      "Bash(rm *)",
      "Bash(npm *)",
      "Bash(npx *)"
    ]
  }
}
