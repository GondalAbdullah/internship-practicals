{
  "outputStyle": "Concise",
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "WebFetch(domain:www.tedbaker.com)",
      "WebFetch(domain:getbootstrap.com)",
      "WebFetch(domain:icons.getbootstrap.com)",
      "WebFetch(domain:www.jsdelivr.com)",
      "WebFetch(domain:fonts.google.com)"
    ],
    "deny": [
      "Bash(git *)",
      "Bash(rm -rf *)",
      "Bash(npm *)",
      "Bash(npx *)"
    ]
  }
}
